# Autenticación Microsoft Entra ID
# false = modo dev (sin MSAL, usuario mock)
# true  = modo prod (MSAL real)
VITE_AUTH_ENABLED=false

# Credenciales Entra ID (sólo cuando VITE_AUTH_ENABLED=true)
VITE_AZURE_CLIENT_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
VITE_AZURE_TENANT_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# URL del BFF (en prod apunta al API Gateway)
VITE_API_URL=http://localhost:8080

# Rol del usuario mock (sólo cuando VITE_AUTH_ENABLED=false)
# Valores: CLIENTE | OPERADOR | ADMINISTRADOR
VITE_MOCK_ROLE=CLIENTE
VITE_MOCK_NAME=María García
VITE_MOCK_EMAIL=mgarcia@empresa.cl
